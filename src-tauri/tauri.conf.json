{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Scrolle",
  "version": "0.1.0",
  "identifier": "com.example.scrolle",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Scrolle",
        "width": 1100,
        "height": 850,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false,
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["epub"],
        "name": "EPUB book",
        "description": "EPUB book",
        "mimeType": "application/epub+zip",
        "role": "Viewer"
      }
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
